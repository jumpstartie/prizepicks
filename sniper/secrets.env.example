# Copy to secrets/sniper.env (gitignored) and fill in.
# NEVER paste private keys into chat or commit them.

# --- Phantom / Solana wallet ---
# Public address (safe) — used for balance checks / paper tracking
PHANTOM_PUBLIC_KEY=
# Private key (NEVER commit / NEVER paste in chat) — required only for live buys
# Phantom → Settings → Security & Privacy → Export Private Key
PHANTOM_PRIVATE_KEY=
# Optional: path instead of inline key
# PHANTOM_PRIVATE_KEY_FILE=secrets/phantom.key

# Solana RPC (public works for tiny tests; use a paid RPC for live snipes)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Mode ---
# paper = simulate buys/sells only (default, safe)
# live  = sign+send via PumpPortal local trade API (real SOL)
SNIPER_MODE=paper

# Buy size in SOL when a coin passes filters
BUY_SOL=0.05
# Max open positions
MAX_OPEN=3
# Take profit / stop loss as multiples of entry (paper + live sell signals)
TAKE_PROFIT_X=2.0
STOP_LOSS_X=0.55
# Slippage % and priority fee (SOL) for live trades
SLIPPAGE_PCT=12
PRIORITY_FEE_SOL=0.001

# --- Quality / community gates ---
MIN_TWITTER_FOLLOWERS=50
REQUIRE_WEBSITE=1
REQUIRE_TWITTER_PROFILE=1
# Reject twitter.com/.../status/... spam links (usually not a real community)
REJECT_STATUS_LINKS=1
MIN_PUMP_REPLIES=5
# Prefer early but not brand-new dust: USD mcap band
MIN_USD_MCAP=8000
MAX_USD_MCAP=250000
# Minimum community quality score 0-100
MIN_QUALITY_SCORE=55

# Poll interval seconds for pump.fun feed
POLL_SECS=8

# Optional Axiom auth (Pulse / SDK). Leave blank to use pump.fun public feed only.
AXIOM_ACCESS_TOKEN=
AXIOM_REFRESH_TOKEN=
